# Copy to .env and fill in. Never commit .env.
# Answering runs on free infrastructure: Groq's free tier (default) or a local Ollama model.
COURSE_QA_LLM_PROVIDER=groq
GROQ_API_KEY=
# Leave empty for the defaults: Groq openai/gpt-oss-120b (low reasoning effort),
# falling back to openai/gpt-oss-20b; Ollama llama3.1:8b.
COURSE_QA_ANSWER_MODEL=
COURSE_QA_FALLBACK_MODEL=
COURSE_QA_REASONING_EFFORT=
COURSE_QA_OLLAMA_URL=http://localhost:11434

COURSE_QA_LECTURES_DIR=data/raw
COURSE_QA_INDEX_DIR=data/index
COURSE_QA_CONFIG=eval/configs/baseline.yaml
COURSE_QA_API_URL=http://127.0.0.1:8000
